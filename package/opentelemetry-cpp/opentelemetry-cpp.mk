################################################################################
#
# opentelemetry-cpp
#
################################################################################

OPENTELEMETRY_CPP_VERSION = 1.29.0
OPENTELEMETRY_CPP_SITE = $(call github,open-telemetry,opentelemetry-cpp,v$(OPENTELEMETRY_CPP_VERSION))
OPENTELEMETRY_CPP_LICENSE = Apache-2.0
OPENTELEMETRY_CPP_LICENSE_FILES = LICENSE
OPENTELEMETRY_CPP_INSTALL_STAGING = YES

# Library only: no tests, examples or benchmarks
OPENTELEMETRY_CPP_CONF_OPTS = \
	-DOTELCPP_INSTALL=ON \
	-DOTELCPP_BUILD_TESTING=OFF \
	-DOTELCPP_BUILD_W3CTRACECONTEXT_TEST=OFF \
	-DOTELCPP_WITH_EXAMPLES=OFF \
	-DOTELCPP_WITH_FUNC_TESTS=OFF \
	-DOTELCPP_WITH_BENCHMARK=OFF

# Every OTLP exporter generates its code from the .proto files in
# host-opentelemetry-proto. Cross build: protoc must be the host binary.
# gRPC is not offered: libabseil-cpp is not packaged in this Buildroot.
ifneq ($(BR2_PACKAGE_OPENTELEMETRY_CPP_OTLP_HTTP)$(BR2_PACKAGE_OPENTELEMETRY_CPP_OTLP_FILE),)
OPENTELEMETRY_CPP_DEPENDENCIES += protobuf host-protobuf host-opentelemetry-proto
OPENTELEMETRY_CPP_CONF_OPTS += \
	-DOTELCPP_PROTO_PATH=$(HOST_DIR)/share/opentelemetry-proto \
	-DProtobuf_PROTOC_EXECUTABLE=$(HOST_DIR)/bin/protoc
endif

OPENTELEMETRY_CPP_CONF_OPTS += -DOTELCPP_WITH_OTLP_GRPC=OFF

ifeq ($(BR2_PACKAGE_OPENTELEMETRY_CPP_OTLP_HTTP),y)
OPENTELEMETRY_CPP_CONF_OPTS += -DOTELCPP_WITH_OTLP_HTTP=ON
OPENTELEMETRY_CPP_DEPENDENCIES += libcurl json-for-modern-cpp
else
OPENTELEMETRY_CPP_CONF_OPTS += -DOTELCPP_WITH_OTLP_HTTP=OFF
endif

ifeq ($(BR2_PACKAGE_OPENTELEMETRY_CPP_OTLP_HTTP_COMPRESSION),y)
OPENTELEMETRY_CPP_CONF_OPTS += -DOTELCPP_WITH_OTLP_HTTP_COMPRESSION=ON
OPENTELEMETRY_CPP_DEPENDENCIES += zlib
else
OPENTELEMETRY_CPP_CONF_OPTS += -DOTELCPP_WITH_OTLP_HTTP_COMPRESSION=OFF
endif

ifeq ($(BR2_PACKAGE_OPENTELEMETRY_CPP_OTLP_FILE),y)
OPENTELEMETRY_CPP_CONF_OPTS += -DOTELCPP_WITH_OTLP_FILE=ON
OPENTELEMETRY_CPP_DEPENDENCIES += json-for-modern-cpp
else
OPENTELEMETRY_CPP_CONF_OPTS += -DOTELCPP_WITH_OTLP_FILE=OFF
endif

ifeq ($(BR2_PACKAGE_OPENTELEMETRY_CPP_ZIPKIN),y)
OPENTELEMETRY_CPP_CONF_OPTS += -DOTELCPP_WITH_ZIPKIN=ON
OPENTELEMETRY_CPP_DEPENDENCIES += libcurl json-for-modern-cpp
else
OPENTELEMETRY_CPP_CONF_OPTS += -DOTELCPP_WITH_ZIPKIN=OFF
endif

ifeq ($(BR2_PACKAGE_OPENTELEMETRY_CPP_ELASTICSEARCH),y)
OPENTELEMETRY_CPP_CONF_OPTS += -DOTELCPP_WITH_ELASTICSEARCH=ON
OPENTELEMETRY_CPP_DEPENDENCIES += libcurl json-for-modern-cpp
else
OPENTELEMETRY_CPP_CONF_OPTS += -DOTELCPP_WITH_ELASTICSEARCH=OFF
endif

# Prometheus is intentionally not offered: it needs prometheus-cpp + civetweb,
# which Buildroot does not package.
OPENTELEMETRY_CPP_CONF_OPTS += -DOTELCPP_WITH_PROMETHEUS=OFF

$(eval $(cmake-package))
