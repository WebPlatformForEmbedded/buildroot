config BR2_PACKAGE_OPENTELEMETRY_CPP
	bool "opentelemetry-cpp"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_8 # protobuf, libabseil-cpp
	depends on !BR2_STATIC_LIBS
	help
	  OpenTelemetry C++ API and SDK (traces, metrics and logs).

	  https://github.com/open-telemetry/opentelemetry-cpp

if BR2_PACKAGE_OPENTELEMETRY_CPP

config BR2_PACKAGE_OPENTELEMETRY_CPP_OTLP_HTTP
	bool "OTLP HTTP exporter"
	depends on BR2_PACKAGE_PROTOBUF_ARCH_SUPPORTS
	select BR2_PACKAGE_JSON_FOR_MODERN_CPP
	select BR2_PACKAGE_LIBCURL
	select BR2_PACKAGE_PROTOBUF
	help
	  Export telemetry over OTLP/HTTP (uses libcurl).

config BR2_PACKAGE_OPENTELEMETRY_CPP_OTLP_HTTP_COMPRESSION
	bool "gzip compression for OTLP HTTP"
	depends on BR2_PACKAGE_OPENTELEMETRY_CPP_OTLP_HTTP
	select BR2_PACKAGE_ZLIB
	help
	  Allow gzip compression of OTLP/HTTP requests.

config BR2_PACKAGE_OPENTELEMETRY_CPP_OTLP_FILE
	bool "OTLP file exporter"
	depends on BR2_PACKAGE_PROTOBUF_ARCH_SUPPORTS
	select BR2_PACKAGE_JSON_FOR_MODERN_CPP
	select BR2_PACKAGE_PROTOBUF
	help
	  Write telemetry as OTLP JSON to files.

config BR2_PACKAGE_OPENTELEMETRY_CPP_ZIPKIN
	bool "Zipkin exporter"
	select BR2_PACKAGE_JSON_FOR_MODERN_CPP
	select BR2_PACKAGE_LIBCURL
	help
	  Export traces to Zipkin (uses libcurl).

config BR2_PACKAGE_OPENTELEMETRY_CPP_ELASTICSEARCH
	bool "Elasticsearch exporter"
	select BR2_PACKAGE_JSON_FOR_MODERN_CPP
	select BR2_PACKAGE_LIBCURL
	help
	  Export logs to Elasticsearch (uses libcurl).

endif

comment "opentelemetry-cpp needs a toolchain w/ C++, threads, dynamic library, gcc >= 8"
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_TOOLCHAIN_HAS_THREADS \
		|| !BR2_TOOLCHAIN_GCC_AT_LEAST_8 || BR2_STATIC_LIBS
