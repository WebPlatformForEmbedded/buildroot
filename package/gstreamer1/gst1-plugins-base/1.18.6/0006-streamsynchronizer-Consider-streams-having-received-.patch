+  event = gst_event_new_flush_start ();
+  to_push_video = g_list_append (to_push_video, event);
+  private_data_video.expected =
+      g_list_append (private_data_video.expected, gst_event_ref (event));
+
+  GST_DEBUG ("...a flush-stop event");
