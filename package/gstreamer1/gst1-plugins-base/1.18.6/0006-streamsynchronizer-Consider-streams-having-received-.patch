+  fail_if (mysinkpad_video == NULL);
+  fail_unless (gst_pad_link (srcpad_video, mysinkpad_video) == GST_PAD_LINK_OK);
+  fail_unless (gst_pad_set_active (mysinkpad_video, TRUE));
